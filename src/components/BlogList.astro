---
import type { CollectionEntry } from 'astro:content';
import { sanityClient } from 'sanity:client';
import { blogPosts as rssBlogPosts } from '../data/blog-entries';

interface Props {
  limit?: number;
  page?: number;
  showPagination?: boolean;
}

const { limit = 0, page = 1, showPagination = false } = Astro.props;

// Sanityからブログ記事の取得
const posts = await sanityClient.fetch(`*[_type == "post"] | order(publishedAt desc)`);

// Sanityブログ記事をblogPostsと同じ形式に変換
const sanityBlogPosts = posts.map((post: any) => ({
    url: `/blog/${post.slug.current}`,
    title: post.title,
    pubDate: new Date(post.publishedAt),
    source: 'ブログ',
    sourceUrl: '/blog',
  }));

// RSSから取得したブログ記事（既に半年以内でフィルタされている）とSanityブログ記事を結合してソート
const allBlogPosts = [...rssBlogPosts, ...sanityBlogPosts]
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

// ページネーション用の変数
const ITEMS_PER_PAGE = 15;
const totalPosts = allBlogPosts.length;
const totalPages = Math.ceil(totalPosts / ITEMS_PER_PAGE);
const currentPage = Math.min(Math.max(1, page), totalPages || 1);

// 表示するブログ記事の絞り込み
const displayPosts = limit > 0
  ? allBlogPosts.slice(0, limit)
  : allBlogPosts.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);

// 表示用に日付をフォーマットする関数
function formatDate(date: Date): string {
  return `${date.getFullYear()}/${(date.getMonth() + 1).toString().padStart(2, '0')}/${date.getDate().toString().padStart(2, '0')}`;
}

// ソースごとのスタイル設定
const sourceStyles: Record<string, { bg: string; text: string; border: string }> = {
  'PagerDuty': { bg: 'bg-green-50', text: 'text-green-700', border: 'border-green-200' },
  'Cloud Penguins': { bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  'Qiita': { bg: 'bg-lime-50', text: 'text-lime-700', border: 'border-lime-200' },
  'ブログ': { bg: 'bg-stone-50', text: 'text-stone-600', border: 'border-stone-200' },
};

function getSourceStyle(source: string) {
  return sourceStyles[source] || { bg: 'bg-stone-50', text: 'text-stone-600', border: 'border-stone-200' };
}
---

<div class="space-y-3 mt-4">
  {displayPosts.map((post, index) => (
    <article
      class="group relative bg-white rounded-xl border border-stone-100 hover:border-green-200 hover:shadow-md transition-all duration-300 overflow-hidden"
      style={`animation-delay: ${index * 50}ms`}
    >
      <a href={post.url} class="block p-4 sm:p-5">
        <div class="flex flex-col sm:flex-row sm:items-start gap-3">
          <!-- Date and Source Badge -->
          <div class="flex items-center gap-3 sm:flex-col sm:items-start sm:gap-2 sm:w-28 shrink-0">
            <time class="text-sm text-stone-400 font-medium tabular-nums">
              {formatDate(post.pubDate)}
            </time>
            <span
              class={`inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full border ${getSourceStyle(post.source).bg} ${getSourceStyle(post.source).text} ${getSourceStyle(post.source).border}`}
            >
              {post.source}
            </span>
          </div>

          <!-- Title -->
          <div class="flex-1 min-w-0">
            <h3 class="text-stone-800 group-hover:text-green-700 font-semibold text-base sm:text-lg leading-snug transition-colors duration-200" style="font-family: var(--font-display);">
              {post.title}
            </h3>
          </div>

          <!-- Arrow Icon -->
          <div class="hidden sm:flex items-center justify-center w-8 h-8 rounded-lg bg-stone-50 text-stone-400 group-hover:bg-green-50 group-hover:text-green-600 transition-all duration-200 shrink-0 self-center">
            <i class="fas fa-arrow-right text-sm transform group-hover:translate-x-0.5 transition-transform duration-200"></i>
          </div>
        </div>
      </a>

      <!-- Hover accent line -->
      <div class="absolute bottom-0 left-0 h-0.5 w-0 bg-gradient-to-r from-green-400 to-emerald-500 group-hover:w-full transition-all duration-500"></div>
    </article>
  ))}
</div>

{showPagination && totalPages > 1 && (
  <nav class="flex justify-center items-center mt-10" aria-label="ページネーション">
    <div class="inline-flex items-center gap-1 p-1.5 bg-stone-50 rounded-2xl border border-stone-100">
      {currentPage > 1 && (
        <a
          href={`/blog?page=${currentPage - 1}`}
          class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-stone-600 hover:text-green-700 hover:bg-white rounded-xl transition-all duration-200"
          data-page={currentPage - 1}
          aria-label="前のページ"
        >
          <i class="fas fa-chevron-left text-xs"></i>
          <span class="hidden sm:inline">前へ</span>
        </a>
      )}

      <div class="flex items-center gap-1 px-2">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map(pageNum => (
          <a
            href={`/blog?page=${pageNum}`}
            class={`flex items-center justify-center w-10 h-10 text-sm font-semibold rounded-xl transition-all duration-200 ${
              currentPage === pageNum
                ? 'bg-green-600 text-white shadow-md shadow-green-200'
                : 'text-stone-600 hover:bg-white hover:text-green-700 hover:shadow-sm'
            }`}
            data-page={pageNum}
            aria-current={currentPage === pageNum ? 'page' : undefined}
          >
            {pageNum}
          </a>
        ))}
      </div>

      {currentPage < totalPages && (
        <a
          href={`/blog?page=${currentPage + 1}`}
          class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-stone-600 hover:text-green-700 hover:bg-white rounded-xl transition-all duration-200"
          data-page={currentPage + 1}
          aria-label="次のページ"
        >
          <span class="hidden sm:inline">次へ</span>
          <i class="fas fa-chevron-right text-xs"></i>
        </a>
      )}
    </div>
  </nav>
)}

<script>
  // ページネーションリンクのクリックイベント処理
  document.addEventListener('DOMContentLoaded', () => {
    const paginationLinks = document.querySelectorAll('a[data-page]');

    paginationLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const page = link.getAttribute('data-page');
        // 強制的にページをリロード
        window.location.href = `/blog?page=${page}`;
      });
    });
  });
</script>

{limit > 0 && allBlogPosts.length > limit && (
  <div class="text-center mt-8">
    <a href="/blog/page/1" class="inline-flex items-center gap-2 px-6 py-3 text-green-700 hover:text-green-800 font-semibold bg-green-50 hover:bg-green-100 rounded-xl border border-green-200 hover:border-green-300 transition-all duration-200 group" style="font-family: var(--font-display);">
      <span>すべての記事を見る</span>
      <i class="fas fa-arrow-right text-sm transform group-hover:translate-x-1 transition-transform duration-200"></i>
    </a>
  </div>
)}
