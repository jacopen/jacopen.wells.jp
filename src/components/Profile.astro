      </div>
    </div>

    <div class="border-dotted border-b border-gray-200 pb-4">
      <h3 class="text-lg font-semibold text-gray-800">Pittan</h3>
      <div class="flex justify-between items-center mt-1">
        <p class="text-gray-600">技術顧問</p>
        <p class="text-sm text-gray-500">2023/4 - 2024/2</p>
      </div>
    </div>

    <div class="border-dotted border-b border-gray-200 pb-4">
      <h3 class="text-lg font-semibold text-gray-800">VMware</h3>
      <div class="flex justify-between items-center mt-1">
        <p class="text-gray-600">Senior Cloud Native Architect</p>
        <p class="text-sm text-gray-500">2020/4 - 2021/9</p>
      </div>
    </div>

    <div class="border-dotted border-b border-gray-200 pb-4">
      <h3 class="text-lg font-semibold text-gray-800">Pivotal</h3>
      <div class="flex justify-between items-center mt-1">
        <p class="text-gray-600">Senior Solutions Engineer</p>
        <p class="text-sm text-gray-500">2017/3 - 2020/4</p>
      </div>
    </div>

    <div class="border-dotted border-b border-gray-200 pb-4">
      <h3 class="text-lg font-semibold text-gray-800">NTT Communications</h3>
      <div class="flex justify-between items-center mt-1">
        <p class="text-gray-600">Tech Lead</p>
        <p class="text-sm text-gray-500">2012/4 - 2017/3</p>
      </div>
    </div>
  </div>
  <h2 id="blog" class="text-2xl font-bold mt-8">ブログ</h2>
  <div class="space-y-4 mt-4">
    {blogPosts.map(post => (
      <div class="border-b border-gray-100 pb-3">
        <div class="flex items-center mb-1 text-sm text-gray-600">
          <span class="mr-2">{post.pubDate.getFullYear()}/{(post.pubDate.getMonth() + 1).toString().padStart(2, '0')}/{post.pubDate.getDate().toString().padStart(2, '0')}</span>
          <a href={post.sourceUrl} class="font-medium" style={post.source === 'PagerDuty' ? 'color: #25c151;' : 'color: #3498db;'}>
            {post.source}
          </a>
        </div>
        <a href={post.url} class="text-gray-800 hover:text-blue-600 font-medium text-lg block">
          {post.title}
        </a>
      </div>
    ))}
  </div>
  <h2 id="presentations" class="text-2xl font-bold mt-8">登壇</h2>
  <div class="space-y-4 mt-4">
    {presentations.map(presentation => (
      <div class="border-b border-gray-100 pb-3">
        <div class="flex items-center mb-1 text-sm text-gray-600">
          <span class="mr-2">{presentation.pubDate.getFullYear()}/{(presentation.pubDate.getMonth() + 1).toString().padStart(2, '0')}/{presentation.pubDate.getDate().toString().padStart(2, '0')}</span>
