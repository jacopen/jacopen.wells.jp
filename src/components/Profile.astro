---
import { books, presentations, contributions, profileInfo, skills, communities, careers } from '../data/profile-content';
import BlogList from './BlogList.astro';

const { nameEn, nameJa, nickname, titlePagerDuty, titleCNIA, bio } = profileInfo;

// カテゴリに応じた色を定義
const categoryColors: Record<string, string> = {
  Platform: "bg-blue-100 text-blue-800 border-blue-200",
  DevOps: "bg-green-100 text-green-800 border-green-200",
  Incident: "bg-red-100 text-red-800 border-red-200",
  Infrastructure: "bg-purple-100 text-purple-800 border-purple-200",
  SoftSkill: "bg-yellow-100 text-yellow-800 border-yellow-200",
  Language: "bg-pink-100 text-pink-800 border-pink-200",
  Design: "bg-orange-100 text-orange-800 border-orange-200",
  Other: "bg-gray-100 text-gray-800 border-gray-200"
};

// カテゴリで分類してスキルをグループ化
const skillsByCategory = skills.reduce((acc, skill) => {
  if (!acc[skill.category]) {
    acc[skill.category] = [];
  }
  acc[skill.category].push(skill);
  return acc;
}, {} as Record<string, typeof skills>);

// カテゴリの表示順序を定義
const categoryOrder = [
  "Platform", 
  "DevOps", 
  "Incident", 
  "Infrastructure", 
  "SoftSkill", 
  "Language", 
  "Design", 
  "Other"
];

// ソートされたカテゴリリスト
const sortedCategories = Object.keys(skillsByCategory).sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

<div id="profile" class="flex items-center">
  <div class="flex flex-col md:flex-row items-center md:items-start">
    <img src="/pen_pen.jpg" alt="草間 一人" class="rounded-full w-48 h-48 mb-4 md:mr-4 md:mb-0" />
    <div class="text-center md:text-left">
      <h1 class="text-4xl font-bold">{nameEn} <span class="text-2xl text-gray-600 font-normal">({nameJa})</span></h1>
      <p class="text-2xl text-gray-600 mb-2">@{nickname}</p>
      <p class="text-gray-700 mb-1">{titlePagerDuty}</p>
      <p class="text-gray-700 mb-4">{titleCNIA}</p>
      <div class="flex space-x-4 justify-center md:justify-start">
        <a href="https://x.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-x"></i> @jacopen</a>
        <a href="https://www.facebook.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-facebook"></i> Facebook</a>
        <a href="https://github.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://www.linkedin.com/in/jacopen/" class="text-blue-500 hover:text-blue-700"><i class="fab fa-linkedin"></i> LinkedIn</a>
      </div>
    </div>
  </div>
</div>

<p class="text-gray-700 mt-4 mb-8">{bio}</p>

<h2 id="blog" class="text-2xl font-bold mt-8">ブログ</h2>
<BlogList limit={10} />

<div id="career" class="space-y-2">
  <h2 class="text-2xl font-bold mt-8">経歴</h2>
  {careers.map(career => (
    <div class="border-dotted border-b border-gray-200 pb-4">
      <h3 class="text-lg font-semibold text-gray-800">{career.company}</h3>
      <div class="flex justify-between items-center mt-1">
        <p class="text-gray-600">{career.position}</p>
        <p class="text-sm text-gray-500">{career.period}</p>
      </div>
    </div>
  ))}
</div>

<h2 id="presentations" class="text-2xl font-bold mt-8">登壇</h2>
<div class="space-y-4 mt-4">
  {presentations.map(presentation => (
    <div class="border-b border-gray-100 pb-3">
      <div class="flex items-center mb-1 text-sm text-gray-600">
        <span class="mr-2">{presentation.pubDate.getFullYear()}/{(presentation.pubDate.getMonth() + 1).toString().padStart(2, '0')}/{presentation.pubDate.getDate().toString().padStart(2, '0')}</span>
      </div>
      <a href={presentation.url} class="text-gray-800 hover:text-blue-600 font-medium text-lg block mb-2">
        {presentation.title}
      </a>
      {presentation.content && (
        <div class="text-gray-600 text-sm">
          {presentation.content}
        </div>
      )}
    </div>
  ))}
  <div class="text-center mt-4">
    <a href="/presentations/page/1" class="text-blue-500 hover:text-blue-700">
      全ての登壇を見る <i class="fas fa-arrow-right"></i>
    </a>
  </div>
</div>

<div id="skills" class="mt-8">
  <h2 class="text-2xl font-bold mb-4">スキル</h2>
  <div class="space-y-4">
    {sortedCategories.map(category => (
      <div class="mb-4">
        <h3 class="text-md font-medium text-gray-700 mb-2">
          {category === "Platform" && "プラットフォーム"}
          {category === "DevOps" && "DevOps/SRE"}
          {category === "Incident" && "インシデント管理"}
          {category === "Infrastructure" && "インフラストラクチャ"}
          {category === "SoftSkill" && "ソフトスキル"}
          {category === "Language" && "プログラミング言語"}
          {category === "Design" && "デザイン"}
          {category === "Other" && "その他"}
        </h3>
        <div class="flex flex-wrap gap-2">
          {skillsByCategory[category].map(skill => (
            <span 
              class={`inline-block px-2 py-1 rounded-full border text-sm ${categoryColors[category]} hover:opacity-80 transition-all duration-200`}
            >
              {skill.name}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<h2 id="contributions" class="text-2xl font-bold mt-8">寄稿 / メディア記事</h2>
<ul class="list-disc list-inside">
  {contributions.map(contribution => (
    <li>
      <a href={contribution.url} class="text-blue-500 hover:text-blue-700">
        {contribution.title}
      </a>
    </li>
  ))}
</ul>

<h2 id="books" class="text-2xl font-bold mt-8">書籍</h2>
<ul class="list-disc list-inside">
  {books.map(book => (
    <li>
      <a href={book.url} class="text-blue-500 hover:text-blue-700">
        {book.title}
      </a>
    </li>
  ))}
</ul>

<h2 id="communities" class="text-2xl font-bold mt-8">コミュニティ活動</h2>
<div class="space-y-4 mt-4">
  {communities.map(community => (
    <div class="border-b border-gray-100 pb-3">
      <a href={community.url} class="text-gray-800 hover:text-blue-600 font-medium text-lg block mb-2">
        {community.name}
      </a>
      <div class="text-gray-600 text-sm">
        {community.activity}
      </div>
    </div>
  ))}
</div>
