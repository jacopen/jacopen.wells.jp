---
import { blogPosts, books, presentations, contributions } from '../data/profile-content';

const nameEn = "Kazuto Kusama";
const nameJa = "草間 一人";
const nickname = "jacopen";

// セクションのリンク一覧
const sections = [
  { id: "profile", title: "プロフィール" },
  { id: "career", title: "経歴" },
  { id: "blog", title: "ブログ" },
  { id: "presentations", title: "登壇" },
  { id: "contributions", title: "寄稿 / メディア記事" },
  { id: "books", title: "書籍" }
];

---

<script>
  // ハンバーガーメニューの開閉を制御
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    
    // メニューを閉じる関数
    const closeMenu = () => {
      mobileMenu?.classList.add('hidden');
      mobileMenuOverlay?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };
    
    // メニューを開く
    menuButton?.addEventListener('click', () => {
      mobileMenu?.classList.remove('hidden');
      mobileMenuOverlay?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    });
    
    // 閉じるボタンクリック時
    closeButton?.addEventListener('click', closeMenu);
    
    // オーバーレイクリック時
    mobileMenuOverlay?.addEventListener('click', closeMenu);
    
    // セクションリンククリック時にメニューを閉じる
    const mobileLinks = document.querySelectorAll('#mobile-menu a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  });
</script>

<div class="container mx-auto px-4 py-5 max-w-full overflow-x-hidden">
  <!-- モバイル向けのハンバーガーメニュー -->
  <div class="md:hidden mb-6 relative">
    <button 
      id="mobile-menu-button" 
      class="text-gray-800 hover:text-blue-600 p-2 flex items-center"
      aria-label="メニューを開く"
    >
      <i class="fas fa-bars text-xl mr-2"></i>
      <span>メニュー</span>
    </button>
    
    <!-- オーバーレイ背景 -->
    <div id="mobile-menu-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>
    
    <!-- モバイルメニュー -->
    <div id="mobile-menu" class="fixed inset-y-0 left-0 w-64 bg-white shadow-lg z-50 overflow-y-auto hidden">
      <div class="p-4">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-lg font-bold">メニュー</h3>
          <button id="mobile-menu-close" class="text-gray-600">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <nav class="space-y-4">
          {sections.map(section => (
            <a href={`#${section.id}`} class="block py-2 px-3 text-gray-800 hover:text-blue-600 hover:bg-blue-50 rounded">
              {section.title}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>

  <!-- 2ペインレイアウト -->
  <div class="flex flex-col md:flex-row">
    <!-- 左側サイドバー -->
    <div class="hidden md:block md:w-1/4 lg:w-1/5 mr-12 border-r border-dashed border-gray-200">
      <div class="sticky top-8">
        <nav class="space-y-3">
          {sections.map(section => (
            <a href={`#${section.id}`} class="block text-gray-800 hover:text-blue-600 hover:bg-blue-50 p-2 rounded text-right">
              {section.title}
            </a>
          ))}
        </nav>
      </div>
    </div>
    
    <!-- メインコンテンツ -->
    <div class="md:w-3/4 lg:w-4/5">
  <div id="profile" class="flex items-center">
    <div class="flex flex-col md:flex-row items-center md:items-start">
      <img src="/pen_pen.jpg" alt="草間 一人" class="rounded-full w-48 h-48 mb-4 md:mr-4 md:mb-0" />
      <div class="text-center md:text-left">
        <h1 class="text-4xl font-bold">{nameEn} <span class="text-2xl text-gray-600 font-normal">({nameJa})</span></h1>
        <p class="text-2xl text-gray-600 mb-2">@{nickname}</p>
        <p class="text-gray-700 mb-1">PagerDuty　プロダクトエバンジェリスト</p>
        <p class="text-gray-700 mb-4">一般社団法人クラウドネイティブイノベーターズ協会　代表理事</p>
        <div class="flex space-x-4 justify-center md:justify-start">
          <a href="https://x.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-x"></i> @jacopen</a>
          <a href="https://www.facebook.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-facebook"></i> Facebook</a>
          <a href="https://github.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-github"></i> GitHub</a>
          <a href="https://jaco.udcp.info/" class="text-blue-500 hover:text-blue-700">Blog</a>
        </div>
      </div>
    </div>
  </div>
  <p class="text-gray-700 mt-4 mb-8">PagerDutyのProduct Evangelistとして、インシデント管理ソリューションに関する情報発信やコミュニティ作りに携わる。過去には通信事業者でプラットフォームエンジニアを務めたのを皮切りに、いくつかの外資系企業でプロフェッショナルサービスやプリセールスエンジニアとしてクラウドネイティブやプラットフォーム製品に携わるなど、10年以上さまざまな形でプラットフォームに関与している。2023年11月より現職。一般社団法人クラウドネイティブイノベーターズ協会 代表理事。Platform Engineering Meetupオーガナイザー。</p>

  <div id="career" class="space-y-2">
