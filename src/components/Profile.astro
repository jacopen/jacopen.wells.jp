  <h2 id="contributions" class="text-2xl font-bold mt-8">寄稿 / メディア記事</h2>
  <ul class="list-disc list-inside">
    {contributions.map(contribution => (
      <li>
        <a href={contribution.url} class="text-blue-500 hover:text-blue-700">
          {contribution.title}
        </a>
      </li>
