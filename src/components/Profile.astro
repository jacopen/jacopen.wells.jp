---
import { books, presentations, contributions, profileInfo, skills, communities, careers, certifications } from '../data/profile-content';
import BlogList from './BlogList.astro';

const { nameEn, nameJa, nickname, titlePagerDuty, titleCNIA, titleSRE, bio } = profileInfo;

// カテゴリに応じたスタイルクラスを定義
const categoryStyles: Record<string, { bg: string; text: string; border: string; icon: string }> = {
  Platform: { bg: "bg-emerald-50", text: "text-emerald-700", border: "border-emerald-200", icon: "fa-cloud" },
  DevOps: { bg: "bg-blue-50", text: "text-blue-700", border: "border-blue-200", icon: "fa-infinity" },
  Incident: { bg: "bg-rose-50", text: "text-rose-700", border: "border-rose-200", icon: "fa-bell" },
  Infrastructure: { bg: "bg-green-50", text: "text-green-700", border: "border-green-200", icon: "fa-server" },
  SoftSkill: { bg: "bg-amber-50", text: "text-amber-700", border: "border-amber-200", icon: "fa-comments" },
  Language: { bg: "bg-violet-50", text: "text-violet-700", border: "border-violet-200", icon: "fa-code" },
  Design: { bg: "bg-orange-50", text: "text-orange-700", border: "border-orange-200", icon: "fa-palette" },
  Other: { bg: "bg-stone-50", text: "text-stone-600", border: "border-stone-200", icon: "fa-star" }
};

// カテゴリの日本語名
const categoryNames: Record<string, string> = {
  Platform: "プラットフォーム",
  DevOps: "DevOps / SRE",
  Incident: "インシデント管理",
  Infrastructure: "インフラストラクチャ",
  SoftSkill: "ソフトスキル",
  Language: "プログラミング言語",
  Design: "デザイン",
  Other: "その他"
};

// カテゴリで分類してスキルをグループ化
const skillsByCategory = skills.reduce((acc, skill) => {
  if (!acc[skill.category]) {
    acc[skill.category] = [];
  }
  acc[skill.category].push(skill);
  return acc;
}, {} as Record<string, typeof skills>);

// カテゴリの表示順序を定義
const categoryOrder = [
  "Platform",
  "DevOps",
  "Incident",
  "Infrastructure",
  "SoftSkill",
  "Language",
  "Design",
  "Other"
];

// ソートされたカテゴリリスト
const sortedCategories = Object.keys(skillsByCategory).sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

<!-- Profile Header -->
<div id="profile" class="animate-fade-in-up">
  <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-8">
    <!-- Profile Image with Glow Effect -->
    <div class="relative group">
      <div class="absolute -inset-2 bg-gradient-to-br from-green-400 via-emerald-400 to-teal-500 rounded-full opacity-30 group-hover:opacity-40 blur-lg transition-opacity duration-500"></div>
      <img
        src="/pen_pen.jpg"
        alt={nameJa}
        class="relative rounded-full w-40 h-40 md:w-48 md:h-48 ring-4 ring-white shadow-xl object-cover"
      />
    </div>

    <!-- Profile Info -->
    <div class="text-center md:text-left flex-1">
      <h1 class="text-3xl md:text-4xl font-bold text-stone-900" style="font-family: var(--font-display);">
        {nameEn}
        <span class="block md:inline text-xl md:text-2xl text-stone-500 font-normal mt-1 md:mt-0 md:ml-2">
          ({nameJa})
        </span>
      </h1>
      <p class="text-xl md:text-2xl text-green-600 font-medium mt-2">@{nickname}</p>

      <!-- Titles -->
      <div class="mt-4 space-y-1">
        <p class="text-stone-600 flex items-center justify-center md:justify-start gap-2">
          <i class="fas fa-building text-green-500 w-5"></i>
          {titlePagerDuty}
        </p>
        <p class="text-stone-600 flex items-center justify-center md:justify-start gap-2">
          <i class="fas fa-cloud text-green-500 w-5"></i>
          {titleCNIA}
        </p>
        <p class="text-stone-600 flex items-center justify-center md:justify-start gap-2">
          <i class="fas fa-shield text-green-500 w-5"></i>
          {titleSRE}
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex gap-3 mt-5 justify-center md:justify-start">
        <a href="https://x.com/jacopen" class="group flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-50 text-stone-600 hover:bg-stone-900 hover:text-white transition-all duration-200">
          <i class="fab fa-x-twitter"></i>
          <span class="text-sm font-medium">@jacopen</span>
        </a>
        <a href="https://www.facebook.com/jacopen" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:bg-blue-500 hover:text-white transition-all duration-200" aria-label="Facebook">
          <i class="fab fa-facebook text-lg"></i>
        </a>
        <a href="https://github.com/jacopen" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:bg-stone-900 hover:text-white transition-all duration-200" aria-label="GitHub">
          <i class="fab fa-github text-lg"></i>
        </a>
        <a href="https://www.linkedin.com/in/jacopen/" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:bg-blue-600 hover:text-white transition-all duration-200" aria-label="LinkedIn">
          <i class="fab fa-linkedin text-lg"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Bio -->
<p class="text-stone-600 text-lg leading-relaxed mt-8 p-6 bg-stone-50/50 rounded-2xl border border-stone-100 animate-fade-in-up delay-100">
  {bio}
</p>

<!-- Section Divider -->
<div class="section-divider"></div>

<!-- Blog Section -->
<section class="animate-fade-in-up delay-200">
  <h2 id="blog" class="flex items-center gap-3 text-2xl font-bold text-stone-900" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-pen-to-square"></i>
    </span>
    ブログ
  </h2>
  <BlogList limit={10} />
</section>

<div class="section-divider"></div>

<!-- Career Section -->
<section id="career" class="animate-fade-in-up">
  <h2 class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-8" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-briefcase"></i>
    </span>
    経歴
  </h2>

  <div class="relative pl-8">
    <!-- Timeline Line -->
    <div class="absolute left-3 top-2 bottom-2 w-0.5 bg-gradient-to-b from-green-400 via-green-300 to-green-100 rounded-full"></div>

    <div class="space-y-6">
      {careers.map((career, index) => (
        <div class={`relative timeline-item group ${index >= 7 ? 'timeline-item-hidden hidden' : ''}`}>
          <!-- Timeline Dot -->
          <div class="absolute -left-5 top-6 w-4 h-4 bg-white border-[3px] border-green-500 rounded-full shadow-sm group-hover:scale-125 group-hover:border-green-400 transition-all duration-300 z-10"></div>

          <!-- Content Card -->
          <div class="ml-4 p-5 bg-white rounded-2xl border border-stone-100 shadow-sm hover:shadow-md hover:border-green-100 transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
              <h3 class="text-lg font-bold text-stone-800" style="font-family: var(--font-display);">{career.company}</h3>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 text-sm font-medium rounded-full border border-green-100 whitespace-nowrap">
                <i class="fas fa-calendar-alt text-xs"></i>
                {career.period}
              </span>
            </div>
            <p class="text-stone-600 mt-2">{career.position}</p>
          </div>
        </div>
      ))}

      {careers.length > 7 && (
        <div class="text-center pt-2">
          <button
            id="timeline-toggle"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-50 text-green-700 rounded-xl hover:bg-green-100 transition-all duration-200 font-medium"
          >
            <span id="timeline-toggle-text">もっと見る</span>
            <i id="timeline-toggle-icon" class="fas fa-chevron-down transition-transform duration-300"></i>
          </button>
        </div>
      )}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const toggleButton = document.getElementById('timeline-toggle');
  const toggleText = document.getElementById('timeline-toggle-text');
  const toggleIcon = document.getElementById('timeline-toggle-icon');
  const hiddenItems = document.querySelectorAll('.timeline-item-hidden');

  if (toggleButton && hiddenItems.length > 0) {
    let isExpanded = false;

    toggleButton.addEventListener('click', function() {
      isExpanded = !isExpanded;

      hiddenItems.forEach(item => {
        if (isExpanded) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      if (toggleText && toggleIcon) {
        if (isExpanded) {
          toggleText.textContent = '閉じる';
          toggleIcon.style.transform = 'rotate(180deg)';
        } else {
          toggleText.textContent = 'もっと見る';
          toggleIcon.style.transform = 'rotate(0deg)';
        }
      }
    });
  }
});
</script>

<div class="section-divider"></div>

<!-- Presentations Section -->
<section class="animate-fade-in-up">
  <h2 id="presentations" class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-microphone"></i>
    </span>
    登壇
  </h2>

  <div class="space-y-3">
    {presentations.slice(0, 5).map(presentation => (
      <a
        href={presentation.url}
        class="block p-4 bg-white rounded-xl border border-stone-100 hover:border-green-200 hover:shadow-md transition-all duration-200 group"
      >
        <div class="flex items-start gap-4">
          <span class="shrink-0 w-16 text-sm text-stone-400 font-mono pt-0.5">
            {presentation.pubDate.getFullYear()}/{(presentation.pubDate.getMonth() + 1).toString().padStart(2, '0')}
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-stone-800 font-medium group-hover:text-green-700 transition-colors line-clamp-2">
              {presentation.title}
            </h3>
            {presentation.content && (
              <p class="text-stone-500 text-sm mt-1 line-clamp-1">{presentation.content}</p>
            )}
          </div>
          <i class="fas fa-arrow-right text-stone-300 group-hover:text-green-500 group-hover:translate-x-1 transition-all shrink-0"></i>
        </div>
      </a>
    ))}
  </div>

  <div class="text-center mt-6">
    <a href="/presentations/page/1" class="inline-flex items-center gap-2 px-5 py-2.5 text-green-600 hover:text-green-700 font-medium group">
      全ての登壇を見る
      <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
    </a>
  </div>
</section>

<div class="section-divider"></div>

<!-- Skills Section -->
<section id="skills" class="animate-fade-in-up">
  <h2 class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-code"></i>
    </span>
    スキル
  </h2>

  <div class="grid gap-4 md:grid-cols-2">
    {sortedCategories.map(category => {
      const style = categoryStyles[category] || categoryStyles.Other;
      return (
        <div class={`p-5 rounded-2xl ${style.bg} border ${style.border}`}>
          <h3 class={`flex items-center gap-2 text-sm font-semibold ${style.text} mb-3`}>
            <i class={`fas ${style.icon}`}></i>
            {categoryNames[category] || category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skillsByCategory[category].map(skill => (
              <span class={`px-3 py-1.5 rounded-lg bg-white/80 ${style.text} text-sm font-medium border ${style.border} hover:bg-white transition-colors`}>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<div class="section-divider"></div>

<!-- Certifications Section -->
<section class="animate-fade-in-up">
  <h2 id="certifications" class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-award"></i>
    </span>
    認定資格
  </h2>

  <div class="grid gap-4 md:grid-cols-2">
    {certifications.map(cert => (
      <div class="p-5 bg-white rounded-2xl border border-stone-100 shadow-sm hover:shadow-md hover:border-blue-100 transition-all duration-200 group">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <h3 class="text-lg font-bold text-stone-800" style="font-family: var(--font-display);">{cert.name}</h3>
            <p class="text-stone-500 text-sm mt-1">{cert.issuer}</p>
          </div>
          <span class="shrink-0 px-2.5 py-1 bg-blue-50 text-blue-600 text-xs font-medium rounded-lg border border-blue-100">
            {cert.category}
          </span>
        </div>

        <div class="flex items-center justify-between mt-4 pt-4 border-t border-stone-100">
          <span class="text-stone-400 text-sm flex items-center gap-1.5">
            <i class="fas fa-calendar-check"></i>
            {cert.date}
          </span>
          {cert.url && (
            <a href={cert.url} class="text-green-600 hover:text-green-700 text-sm font-medium flex items-center gap-1.5 group-hover:gap-2 transition-all">
              証明書を見る
              <i class="fas fa-external-link-alt text-xs"></i>
            </a>
          )}
        </div>

        {cert.credentialId && (
          <p class="mt-3 text-xs text-stone-400 font-mono">ID: {cert.credentialId}</p>
        )}
      </div>
    ))}
  </div>
</section>

<div class="section-divider"></div>

<!-- Contributions Section -->
<section class="animate-fade-in-up">
  <h2 id="contributions" class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-newspaper"></i>
    </span>
    寄稿 / メディア記事
  </h2>

  <div class="grid gap-3">
    {contributions.map(contribution => (
      <a
        href={contribution.url}
        class="flex items-center gap-3 p-4 bg-white rounded-xl border border-stone-100 hover:border-green-200 hover:shadow-sm transition-all duration-200 group"
      >
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-stone-50 text-stone-400 group-hover:bg-green-50 group-hover:text-green-500 transition-colors shrink-0">
          <i class="fas fa-file-lines"></i>
        </span>
        <span class="text-stone-700 group-hover:text-green-700 transition-colors flex-1">{contribution.title}</span>
        <i class="fas fa-arrow-right text-stone-300 group-hover:text-green-500 group-hover:translate-x-1 transition-all shrink-0"></i>
      </a>
    ))}
  </div>
</section>

<div class="section-divider"></div>

<!-- Books Section -->
<section class="animate-fade-in-up">
  <h2 id="books" class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-book"></i>
    </span>
    書籍
  </h2>

  <div class="grid gap-3">
    {books.map(book => (
      <a
        href={book.url}
        class="flex items-center gap-3 p-4 bg-white rounded-xl border border-stone-100 hover:border-green-200 hover:shadow-sm transition-all duration-200 group"
      >
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-amber-50 text-amber-500 group-hover:bg-green-50 group-hover:text-green-500 transition-colors shrink-0">
          <i class="fas fa-book-open"></i>
        </span>
        <span class="text-stone-700 group-hover:text-green-700 transition-colors flex-1">{book.title}</span>
        <i class="fas fa-arrow-right text-stone-300 group-hover:text-green-500 group-hover:translate-x-1 transition-all shrink-0"></i>
      </a>
    ))}
  </div>
</section>

<div class="section-divider"></div>

<!-- Communities Section -->
<section class="animate-fade-in-up">
  <h2 id="communities" class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-users"></i>
    </span>
    コミュニティ活動
  </h2>

  <div class="grid gap-4">
    {communities.map(community => (
      <a
        href={community.url}
        class="block p-5 bg-white rounded-2xl border border-stone-100 hover:border-green-200 hover:shadow-md transition-all duration-200 group"
      >
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <h3 class="text-lg font-bold text-stone-800 group-hover:text-green-700 transition-colors" style="font-family: var(--font-display);">
              {community.name}
            </h3>
            <p class="text-stone-500 mt-2">{community.activity}</p>
          </div>
          <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50 text-stone-400 group-hover:bg-green-50 group-hover:text-green-500 transition-colors">
            <i class="fas fa-arrow-right"></i>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<div class="section-divider"></div>

<!-- Contact Section -->
<section id="contact" class="animate-fade-in-up">
  <h2 class="flex items-center gap-3 text-2xl font-bold text-stone-900 mb-6" style="font-family: var(--font-display);">
    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-100 text-green-600">
      <i class="fas fa-envelope"></i>
    </span>
    講演・寄稿依頼・お問い合わせ
  </h2>

  <div class="space-y-6">
    <!-- Speaking Topics -->
    <div class="p-6 bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border border-green-100">
      <h3 class="text-lg font-semibold text-green-800 mb-4 flex items-center gap-2" style="font-family: var(--font-display);">
        <i class="fas fa-microphone-lines"></i>
        講演・寄稿・セッション依頼について
      </h3>
      <p class="text-stone-600 mb-5">以下のテーマでの講演・寄稿・セッションを承っております:</p>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-4 bg-white/60 rounded-xl">
          <h4 class="font-semibold text-stone-800 mb-3 flex items-center gap-2">
            <i class="fas fa-cloud text-green-500"></i>
            プラットフォーム・インフラ
          </h4>
          <ul class="space-y-2 text-stone-600 text-sm">
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>Platform Engineering</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>Cloud Native技術</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>DevOps/SRE</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>CI/CD</li>
          </ul>
        </div>
        <div class="p-4 bg-white/60 rounded-xl">
          <h4 class="font-semibold text-stone-800 mb-3 flex items-center gap-2">
            <i class="fas fa-sitemap text-green-500"></i>
            運用・組織
          </h4>
          <ul class="space-y-2 text-stone-600 text-sm">
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>インシデント管理</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>コミュニティ運営</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>技術エバンジェリズム</li>
          </ul>
        </div>
      </div>

      <p class="text-sm text-stone-500 mt-5 flex items-center gap-2">
        <i class="fas fa-info-circle"></i>
        オンライン・オフライン問わず対応可能です。内容や規模についてもお気軽にご相談ください。
      </p>
    </div>

    <!-- Contact CTA -->
    <div class="p-6 bg-white rounded-2xl border border-stone-200 shadow-sm">
      <h3 class="text-lg font-semibold text-stone-800 mb-3 flex items-center gap-2" style="font-family: var(--font-display);">
        <i class="fas fa-paper-plane text-stone-400"></i>
        お問い合わせ
      </h3>
      <p class="text-stone-600 mb-5">
        技術相談、メディア取材、その他のお問い合わせについてもお気軽にご連絡ください。
      </p>
      <div class="text-center">
        <a
          href="https://jacopen.notion.site/1ffb074bc48180bd98dfead5eb7ad7b2?pvs=105"
          class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-xl hover:bg-green-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 font-medium"
        >
          <i class="fas fa-external-link-alt"></i>
          お問い合わせフォームはこちら
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Bottom Spacing -->
<div class="h-12"></div>
