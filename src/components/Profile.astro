---
import { books, presentations, contributions } from '../data/profile-content';
import BlogList from './BlogList.astro';

const nameEn = "Kazuto Kusama";
const nameJa = "草間 一人";
const nickname = "jacopen";

// セクションのリンク一覧
const sections = [
  { id: "profile", title: "プロフィール" },
  { id: "career", title: "経歴" },
  { id: "blog", title: "ブログ" },
  { id: "presentations", title: "登壇" },
  { id: "contributions", title: "寄稿 / メディア記事" },
  { id: "books", title: "書籍" }
];
---

<div id="profile" class="flex items-center">
  <div class="flex flex-col md:flex-row items-center md:items-start">
    <img src="/pen_pen.jpg" alt="草間 一人" class="rounded-full w-48 h-48 mb-4 md:mr-4 md:mb-0" />
    <div class="text-center md:text-left">
      <h1 class="text-4xl font-bold">{nameEn} <span class="text-2xl text-gray-600 font-normal">({nameJa})</span></h1>
      <p class="text-2xl text-gray-600 mb-2">@{nickname}</p>
      <p class="text-gray-700 mb-1">PagerDuty　プロダクトエバンジェリスト</p>
      <p class="text-gray-700 mb-4">一般社団法人クラウドネイティブイノベーターズ協会　代表理事</p>
      <div class="flex space-x-4 justify-center md:justify-start">
        <a href="https://x.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-x"></i> @jacopen</a>
        <a href="https://www.facebook.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-facebook"></i> Facebook</a>
        <a href="https://github.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://jaco.udcp.info/" class="text-blue-500 hover:text-blue-700">Blog</a>
      </div>
    </div>
  </div>
</div>

<p class="text-gray-700 mt-4 mb-8">PagerDutyのProduct Evangelistとして、インシデント管理ソリューションに関する情報発信やコミュニティ作りに携わる。過去には通信事業者でプラットフォームエンジニアを務めたのを皮切りに、いくつかの外資系企業でプロフェッショナルサービスやプリセールスエンジニアとしてクラウドネイティブやプラットフォーム製品に携わるなど、10年以上さまざまな形でプラットフォームに関与している。2023年11月より現職。一般社団法人クラウドネイティブイノベーターズ協会 代表理事。Platform Engineering Meetupオーガナイザー。</p>

<div id="career" class="space-y-2">
  <h2 class="text-2xl font-bold mt-8">経歴</h2>
  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">PagerDuty</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">Product Evangelist</p>
      <p class="text-sm text-gray-500">2023/11 - 現在</p>
    </div>
  </div>

  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">一般社団法人クラウドネイティブイノベーターズ協会</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">代表理事</p>
      <p class="text-sm text-gray-500">2023/6 - 現在</p>
    </div>
  </div>

  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">HashiCorp</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">Senior Solutions Engineer</p>
      <p class="text-sm text-gray-500">2021/9 - 2023/11</p>
    </div>
  </div>

  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">Pittan</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">技術顧問</p>
      <p class="text-sm text-gray-500">2023/4 - 2024/2</p>
    </div>
  </div>

  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">VMware</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">Senior Cloud Native Architect</p>
      <p class="text-sm text-gray-500">2020/4 - 2021/9</p>
    </div>
  </div>

  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">Pivotal</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">Senior Solutions Engineer</p>
      <p class="text-sm text-gray-500">2017/3 - 2020/4</p>
    </div>
  </div>

  <div class="border-dotted border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-800">NTT Communications</h3>
    <div class="flex justify-between items-center mt-1">
      <p class="text-gray-600">Tech Lead</p>
      <p class="text-sm text-gray-500">2012/4 - 2017/3</p>
    </div>
  </div>
</div>

<h2 id="blog" class="text-2xl font-bold mt-8">ブログ</h2>
<BlogList limit={10} />

<h2 id="presentations" class="text-2xl font-bold mt-8">登壇</h2>
<div class="space-y-4 mt-4">
  {presentations.map(presentation => (
    <div class="border-b border-gray-100 pb-3">
      <div class="flex items-center mb-1 text-sm text-gray-600">
        <span class="mr-2">{presentation.pubDate.getFullYear()}/{(presentation.pubDate.getMonth() + 1).toString().padStart(2, '0')}/{presentation.pubDate.getDate().toString().padStart(2, '0')}</span>
      </div>
      <a href={presentation.url} class="text-gray-800 hover:text-blue-600 font-medium text-lg block">
        {presentation.title}
      </a>
    </div>
  ))}
</div>

<h2 id="contributions" class="text-2xl font-bold mt-8">寄稿 / メディア記事</h2>
<ul class="list-disc list-inside">
  {contributions.map(contribution => (
    <li>
      <a href={contribution.url} class="text-blue-500 hover:text-blue-700">
        {contribution.title}
      </a>
    </li>
  ))}
</ul>

<h2 id="books" class="text-2xl font-bold mt-8">書籍</h2>
<ul class="list-disc list-inside">
  {books.map(book => (
    <li>
      <a href={book.url} class="text-blue-500 hover:text-blue-700">
        {book.title}
      </a>
    </li>
  ))}
</ul>
