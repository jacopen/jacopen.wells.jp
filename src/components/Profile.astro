---
import { books, presentations, contributions, profileInfo, skills, communities, careers } from '../data/profile-content';
import BlogList from './BlogList.astro';

const { nameEn, nameJa, nickname, titlePagerDuty, titleCNIA, bio } = profileInfo;

// カテゴリに応じた色を定義
const categoryColors: Record<string, string> = {
  Platform: "bg-green-100 text-green-800 border-green-200",
  DevOps: "bg-green-100 text-green-800 border-green-200",
  Incident: "bg-red-100 text-red-800 border-red-200",
  Infrastructure: "bg-green-100 text-green-800 border-green-200",
  SoftSkill: "bg-yellow-100 text-yellow-800 border-yellow-200",
  Language: "bg-green-100 text-green-800 border-green-200",
  Design: "bg-orange-100 text-orange-800 border-orange-200",
  Other: "bg-gray-100 text-gray-800 border-gray-200"
};

// カテゴリで分類してスキルをグループ化
const skillsByCategory = skills.reduce((acc, skill) => {
  if (!acc[skill.category]) {
    acc[skill.category] = [];
  }
  acc[skill.category].push(skill);
  return acc;
}, {} as Record<string, typeof skills>);

// カテゴリの表示順序を定義
const categoryOrder = [
  "Platform", 
  "DevOps", 
  "Incident", 
  "Infrastructure", 
  "SoftSkill", 
  "Language", 
  "Design", 
  "Other"
];

// ソートされたカテゴリリスト
const sortedCategories = Object.keys(skillsByCategory).sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

<div id="profile" class="flex items-center">
  <div class="flex flex-col md:flex-row items-center md:items-start">
    <img src="/pen_pen.jpg" alt="草間 一人" class="rounded-full w-48 h-48 mb-4 md:mr-4 md:mb-0" />
    <div class="text-center md:text-left">
      <h1 class="text-4xl font-bold">{nameEn} <span class="text-2xl text-gray-600 font-normal">({nameJa})</span></h1>
      <p class="text-2xl text-gray-600 mb-2">@{nickname}</p>
      <p class="text-gray-700 mb-1">{titlePagerDuty}</p>
      <p class="text-gray-700 mb-4">{titleCNIA}</p>
      <div class="flex space-x-4 justify-center md:justify-start">
        <a href="https://x.com/jacopen" class="text-green-600 hover:text-green-800"><i class="fab fa-x"></i> @jacopen</a>
        <a href="https://www.facebook.com/jacopen" class="text-green-600 hover:text-green-800"><i class="fab fa-facebook"></i> Facebook</a>
        <a href="https://github.com/jacopen" class="text-green-600 hover:text-green-800"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://www.linkedin.com/in/jacopen/" class="text-green-600 hover:text-green-800"><i class="fab fa-linkedin"></i> LinkedIn</a>
      </div>
    </div>
  </div>
</div>

<p class="text-gray-700 mt-4 mb-8">{bio}</p>

<h2 id="blog" class="text-2xl font-bold mt-8">ブログ</h2>
<BlogList limit={10} />

<div id="career" class="mt-8">
  <h2 class="text-2xl font-bold mb-6">経歴</h2>
  <div class="relative">
    <!-- タイムライン縦線 -->
    <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-green-200"></div>
    
    <div class="space-y-8">
      {careers.map((career, index) => (
        <div class={`relative flex items-start ${index >= 7 ? 'timeline-item-hidden hidden' : ''}`}>
          <!-- タイムライン円 -->
          <div class="absolute left-4 w-4 h-4 bg-green-500 rounded-full border-4 border-white shadow-md z-10"></div>
          
          <!-- コンテンツ -->
          <div class="ml-12 bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-all duration-200 w-full">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-2">
              <h3 class="text-xl font-bold text-gray-800">{career.company}</h3>
              <span class="inline-block bg-green-100 text-green-800 text-sm font-medium px-3 py-1 rounded-full mt-2 md:mt-0">
                {career.period}
              </span>
            </div>
            <p class="text-gray-600 font-medium">{career.position}</p>
          </div>
        </div>
      ))}
      
      {careers.length > 7 && (
        <div class="text-center">
          <button 
            id="timeline-toggle" 
            class="inline-flex items-center px-4 py-2 bg-green-100 text-green-700 rounded-lg hover:bg-green-200 transition-colors"
          >
            <span id="timeline-toggle-text">もっと見る</span>
            <svg id="timeline-toggle-icon" class="ml-2 w-4 h-4 transition-transform" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
            </svg>
          </button>
        </div>
      )}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const toggleButton = document.getElementById('timeline-toggle');
  const toggleText = document.getElementById('timeline-toggle-text');
  const toggleIcon = document.getElementById('timeline-toggle-icon');
  const hiddenItems = document.querySelectorAll('.timeline-item-hidden');
  
  if (toggleButton && hiddenItems.length > 0) {
    let isExpanded = false;
    
    toggleButton.addEventListener('click', function() {
      isExpanded = !isExpanded;
      
      hiddenItems.forEach(item => {
        if (isExpanded) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
      
      if (isExpanded) {
        toggleText.textContent = '閉じる';
        toggleIcon.style.transform = 'rotate(180deg)';
      } else {
        toggleText.textContent = 'もっと見る';
        toggleIcon.style.transform = 'rotate(0deg)';
      }
    });
  }
});
</script>

<h2 id="presentations" class="text-2xl font-bold mt-8">登壇</h2>
<div class="space-y-4 mt-4">
  {presentations.map(presentation => (
    <div class="border-b border-gray-100 pb-3">
      <div class="flex items-center mb-1 text-sm text-gray-600">
        <span class="mr-2">{presentation.pubDate.getFullYear()}/{(presentation.pubDate.getMonth() + 1).toString().padStart(2, '0')}/{presentation.pubDate.getDate().toString().padStart(2, '0')}</span>
      </div>
      <a href={presentation.url} class="text-gray-800 hover:text-green-700 font-medium text-lg block mb-2">
        {presentation.title}
      </a>
      {presentation.content && (
        <div class="text-gray-600 text-sm">
          {presentation.content}
        </div>
      )}
    </div>
  ))}
  <div class="text-center mt-4">
    <a href="/presentations/page/1" class="text-green-600 hover:text-green-800">
      全ての登壇を見る <i class="fas fa-arrow-right"></i>
    </a>
  </div>
</div>

<div id="skills" class="mt-8">
  <h2 class="text-2xl font-bold mb-4">スキル</h2>
  <div class="space-y-4">
    {sortedCategories.map(category => (
      <div class="mb-4">
        <h3 class="text-md font-medium text-gray-700 mb-2">
          {category === "Platform" && "プラットフォーム"}
          {category === "DevOps" && "DevOps/SRE"}
          {category === "Incident" && "インシデント管理"}
          {category === "Infrastructure" && "インフラストラクチャ"}
          {category === "SoftSkill" && "ソフトスキル"}
          {category === "Language" && "プログラミング言語"}
          {category === "Design" && "デザイン"}
          {category === "Other" && "その他"}
        </h3>
        <div class="flex flex-wrap gap-2">
          {skillsByCategory[category].map(skill => (
            <span 
              class={`inline-block px-2 py-1 rounded-full border text-sm ${categoryColors[category]} hover:opacity-80 transition-all duration-200`}
            >
              {skill.name}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<h2 id="contributions" class="text-2xl font-bold mt-8">寄稿 / メディア記事</h2>
<ul class="list-disc list-inside">
  {contributions.map(contribution => (
    <li>
      <a href={contribution.url} class="text-green-600 hover:text-green-800">
        {contribution.title}
      </a>
    </li>
  ))}
</ul>

<h2 id="books" class="text-2xl font-bold mt-8">書籍</h2>
<ul class="list-disc list-inside">
  {books.map(book => (
    <li>
      <a href={book.url} class="text-green-600 hover:text-green-800">
        {book.title}
      </a>
    </li>
  ))}
</ul>

<h2 id="communities" class="text-2xl font-bold mt-8">コミュニティ活動</h2>
<div class="space-y-4 mt-4">
  {communities.map(community => (
    <div class="border-b border-gray-100 pb-3">
      <a href={community.url} class="text-gray-800 hover:text-green-700 font-medium text-lg block mb-2">
        {community.name}
      </a>
      <div class="text-gray-600 text-sm">
        {community.activity}
      </div>
    </div>
  ))}
</div>

<h2 id="contact" class="text-2xl font-bold mt-8">講演・寄稿依頼・お問い合わせ</h2>
<div class="mt-4 space-y-6">
  <div class="bg-green-50 border border-green-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-green-800 mb-3">講演・寄稿・セッション依頼について</h3>
    <p class="text-gray-700 mb-4">以下のテーマでの講演・寄稿・セッションを承っております:</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <h4 class="font-medium text-gray-800 mb-2">プラットフォーム・インフラ</h4>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Platform Engineering</li>
          <li>• Cloud Native技術</li>
          <li>• DevOps/SRE</li>
          <li>• CI/CD</li>
        </ul>
      </div>
      <div>
        <h4 class="font-medium text-gray-800 mb-2">運用・組織</h4>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• インシデント管理</li>
          <li>• コミュニティ運営</li>
          <li>• 技術エバンジェリズム</li>
        </ul>
      </div>
    </div>
    <p class="text-sm text-gray-600">
      オンライン・オフライン問わず対応可能です。内容や規模についてもお気軽にご相談ください。
    </p>
  </div>
  
  <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-3">お問い合わせ</h3>
    <p class="text-gray-700 mb-4">
      技術相談、メディア取材、その他のお問い合わせについてもお気軽にご連絡ください。
    </p>
    <div class="text-center">
      <a href="https://jacopen.notion.site/1ffb074bc48180bd98dfead5eb7ad7b2?pvs=105" class="inline-block bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors">
        お問い合わせフォームはこちら
      </a>
    </div>
  </div>
</div>
