---
interface Props {
  title: string;
  url: string | URL;
}

const { title, url } = Astro.props;
const urlStr = url.toString();

const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(urlStr)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlStr)}`;
const hatenaUrl = `https://b.hatena.ne.jp/entry/panel/?url=${encodeURIComponent(urlStr)}&btitle=${encodeURIComponent(title)}`;
---

<div class="share-buttons flex flex-wrap gap-4 py-8 border-t border-stone-200 mt-12 w-full">
    <div class="w-full text-center text-sm font-bold text-stone-500 mb-2">この記事をシェアする</div>
    <div class="flex justify-center gap-4 w-full">
        <!-- X (Twitter) -->
        <a 
            href={xUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="share-button flex items-center justify-center w-12 h-12 rounded-full bg-stone-900 text-white hover:bg-stone-700 hover:-translate-y-1 transition-all duration-300 shadow-sm"
            aria-label="Share on X"
        >
            <i class="fab fa-x-twitter text-xl"></i>
        </a>

        <!-- Facebook -->
        <a 
            href={facebookUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="share-button flex items-center justify-center w-12 h-12 rounded-full bg-[#1877F2] text-white hover:bg-[#166fe5] hover:-translate-y-1 transition-all duration-300 shadow-sm"
            aria-label="Share on Facebook"
        >
            <i class="fab fa-facebook-f text-xl"></i>
        </a>

        <!-- Hatena Bookmark -->
        <a 
            href={hatenaUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="share-button flex items-center justify-center w-12 h-12 rounded-full bg-[#00A4DE] text-white hover:bg-[#0093c7] hover:-translate-y-1 transition-all duration-300 shadow-sm"
            aria-label="Bookmark on Hatena"
            title="このエントリーをはてなブックマークに追加"
        >
            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-6 h-6">
                <title>Hatena Bookmark</title>
                <path d="M19.5 21a1.2 1.2 0 0 1-.655-.195L12 16.5l-6.845 4.305a1.2 1.2 0 0 1-1.84-1.015V3.6a1.2 1.2 0 0 1 1.2-1.2h15a1.2 1.2 0 0 1 1.2 1.2v16.19a1.2 1.2 0 0 1-1.215 1.21zm-15-2.02l6.22-3.91a2.03 2.03 0 0 1 2.56 0l6.22 3.91V4.4h-15z" />
                <path d="M12 11.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM12 6a2 2 0 1 1 0 4 2 2 0 0 1 0-4z" />
                <path d="M12 11.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z" />
            </svg>
            <span class="font-bold text-lg select-none" style="font-family: Verdana; margin-left: -2px;">B!</span>
        </a>
    </div>
</div>
