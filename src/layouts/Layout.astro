---
import '../styles/global.css';

interface Props {
  title?: string;
  useTwoPane?: boolean;
}

const { title = "Kazuto Kusama", useTwoPane = false } = Astro.props;

// セクションのリンク一覧（2ペーンレイアウト用）
const sections = [
  { id: "profile", title: "プロフィール", href: "/#profile" },
  { id: "career", title: "経歴", href: "/#career" },
  { id: "blog", title: "ブログ", href: "/#blog" },
  { id: "presentations", title: "登壇", href: "/#presentations" },
  { id: "contributions", title: "寄稿 / メディア記事", href: "/#contributions" },
  { id: "books", title: "書籍", href: "/#books" }
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	</head>
	<body class="bg-gray-100 text-gray-800 font-sans antialiased">
    <div class="mx-auto max-w-5xl">
      {useTwoPane ? (
        <div class="container mx-auto px-4 py-5 max-w-full overflow-x-hidden">
          <!-- モバイル向けのハンバーガーメニュー -->
          <div class="md:hidden mb-6 relative">
            <button 
              id="mobile-menu-button" 
              class="text-gray-800 hover:text-blue-600 p-2 flex items-center"
              aria-label="メニューを開く"
            >
              <i class="fas fa-bars text-xl mr-2"></i>
              <span>メニュー</span>
            </button>
            
            <!-- オーバーレイ背景 -->
            <div id="mobile-menu-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>
            
            <!-- モバイルメニュー -->
            <div id="mobile-menu" class="fixed inset-y-0 left-0 w-64 bg-white shadow-lg z-50 overflow-y-auto hidden">
              <div class="p-4">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="text-lg font-bold">メニュー</h3>
                  <button id="mobile-menu-close" class="text-gray-600">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
                <nav class="space-y-4">
                  {sections.map(section => (
                    <a href={section.href} class="block py-2 px-3 text-gray-800 hover:text-blue-600 hover:bg-blue-50 rounded">
                      {section.title}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </div>

          <!-- 2ペインレイアウト -->
          <div class="flex flex-col md:flex-row">
            <!-- 左側サイドバー -->
            <div class="hidden md:block md:w-1/4 lg:w-1/5 mr-12 border-r border-dashed border-gray-200">
              <div class="sticky top-8">
                <nav class="space-y-3">
                  {sections.map(section => (
                    <a href={section.href} class="block text-gray-800 hover:text-blue-600 hover:bg-blue-50 p-2 rounded text-right">
                      {section.title}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
            
            <!-- メインコンテンツ -->
            <div class="md:w-3/4 lg:w-4/5">
              <slot />
            </div>
          </div>
        </div>
      ) : (
        <slot />
      )}
    </div>
</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

{useTwoPane && (
  <script>
    // ハンバーガーメニューの開閉を制御
    document.addEventListener('DOMContentLoaded', () => {
      const menuButton = document.getElementById('mobile-menu-button');
      const closeButton = document.getElementById('mobile-menu-close');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
      
      // メニューを閉じる関数
      const closeMenu = () => {
        mobileMenu?.classList.add('hidden');
        mobileMenuOverlay?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      };
      
      // メニューを開く
      menuButton?.addEventListener('click', () => {
        mobileMenu?.classList.remove('hidden');
        mobileMenuOverlay?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      });
      
      // 閉じるボタンクリック時
      closeButton?.addEventListener('click', closeMenu);
      
      // オーバーレイクリック時
      mobileMenuOverlay?.addEventListener('click', closeMenu);
      
      // セクションリンククリック時にメニューを閉じる
      const mobileLinks = document.querySelectorAll('#mobile-menu a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    });
  </script>
)}
