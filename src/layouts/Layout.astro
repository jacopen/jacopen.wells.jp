---
import '../styles/global.css';
import { profileInfo } from '../data/profile-content';

interface Props {
  title?: string;
  useTwoPane?: boolean;
  isProfilePage?: boolean;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
}

const { 
  title = profileInfo.nameEn, 
  useTwoPane = false, 
  isProfilePage = false,
  ogDescription = profileInfo.bio,
  ogType = "website",
  ogImage = "/gentoo1.png"
} = Astro.props;
const { nameEn, nameJa, nickname } = profileInfo;

// セクションのリンク一覧（2ペーンレイアウト用）
const sections = [
  { id: "profile", title: "プロフィール", href: "/#profile" },
  { id: "blog", title: "ブログ", href: "/#blog" },
  { id: "career", title: "経歴", href: "/#career" },
  { id: "presentations", title: "登壇", href: "/#presentations" },
  { id: "skills", title: "スキル", href: "/#skills" },
  { id: "contributions", title: "寄稿 / メディア記事", href: "/#contributions" },
  { id: "books", title: "書籍", href: "/#books" },
  { id: "communities", title: "コミュニティ活動", href: "/#communities" }
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
		
		<!-- OGP設定 -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />
		<meta property="og:site_name" content={profileInfo.nameEn} />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@jacopen" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={new URL(ogImage, Astro.url)} />
	</head>
	<body class="bg-gray-100 text-gray-800 font-sans antialiased">
    <div class="mx-auto max-w-5xl">
      {useTwoPane ? (
        <div class="container mx-auto px-4 py-5 max-w-full overflow-x-hidden">
          <!-- モバイル向けのハンバーガーメニュー -->
          <div class="md:hidden mb-6 relative">
            <button 
              id="mobile-menu-button" 
              class="text-gray-800 hover:text-blue-600 p-2 flex items-center"
              aria-label="メニューを開く"
            >
              <i class="fas fa-bars text-xl mr-2"></i>
              <span>メニュー</span>
            </button>
            
            <!-- オーバーレイ背景 -->
            <div id="mobile-menu-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>
            
            <!-- モバイルメニュー -->
            <div id="mobile-menu" class="fixed inset-y-0 left-0 w-64 bg-white shadow-lg z-50 overflow-y-auto hidden">
              <div class="p-4">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="text-lg font-bold">メニュー</h3>
                  <button id="mobile-menu-close" class="text-gray-600">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
                
                {!isProfilePage && (
                  <div class="mb-6 text-center pb-4 border-b border-gray-100">
                    <img src="/gentoo1.png" alt=`{nameJa}` class="rounded-full w-24 h-24 mx-auto mb-2" />
                    <div>
                      <h2 class="text-base font-bold">{nickname}</h2>
                      <p class="text-xs text-gray-600 mb-1">{nameJa}</p>
                      <p class="text-xs text-gray-600 mb-2">{nameEn}</p>
                      <div class="flex space-x-3 justify-center text-sm">
                        <a href="https://x.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-x"></i></a>
                        <a href="https://www.facebook.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-facebook"></i></a>
                        <a href="https://github.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-github"></i></a>
                        <a href="https://www.linkedin.com/in/jacopen/" class="text-blue-500 hover:text-blue-700"><i class="fab fa-linkedin"></i></a>
                      </div>
                    </div>
                  </div>
                )}
                
                <nav class="space-y-4">
                  {sections.map(section => (
                    <a href={section.href} class="block py-2 px-3 text-gray-800 hover:text-blue-600 hover:bg-blue-50 rounded">
                      {section.title}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </div>

          <!-- 2ペインレイアウト -->
          <div class="flex flex-col md:flex-row">
            <!-- 左側サイドバー -->
            <div class="hidden md:block md:w-1/4 lg:w-1/5 mr-12 border-r border-dashed border-gray-200">
              <div class="sticky top-8">
                {!isProfilePage && (
                  <div class="mb-8 text-center  text-right">
                    <img src="/gentoo1.png" alt="草間 一人" class="rounded-full w-32 h-32 ml-auto mb-4" />
                    <div class="text-right">
                      <h2 class="text-lg font-bold">{nickname}</h2>
                      <p class="text-sm text-gray-600 mb-1">{nameJa}</p>
                      <p class="text-sm text-gray-600 mb-2">{nameEn}</p>
                      <div class="flex space-x-3 text-sm justify-end">
                        <a href="https://x.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-x"></i></a>
                        <a href="https://www.facebook.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-facebook"></i></a>
                        <a href="https://github.com/jacopen" class="text-blue-500 hover:text-blue-700"><i class="fab fa-github"></i></a>
                        <a href="https://www.linkedin.com/in/jacopen/" class="text-blue-500 hover:text-blue-700"><i class="fab fa-linkedin"></i></a>
                      </div>
                    </div>
                  </div>
                )}
                <nav class="space-y-3">
                  {sections.map(section => (
                    <a href={section.href} class="block text-gray-800 hover:text-blue-600 hover:bg-blue-50 p-2 rounded text-right">
                      {section.title}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
            
            <!-- メインコンテンツ -->
            <div class="md:w-3/4 lg:w-4/5">
              <slot />
            </div>
          </div>
        </div>
      ) : (
        <slot />
      )}
    </div>
</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

{useTwoPane && (
  <script>
    // ハンバーガーメニューの開閉を制御
    document.addEventListener('DOMContentLoaded', () => {
      const menuButton = document.getElementById('mobile-menu-button');
      const closeButton = document.getElementById('mobile-menu-close');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
      
      // メニューを閉じる関数
      const closeMenu = () => {
        mobileMenu?.classList.add('hidden');
        mobileMenuOverlay?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      };
      
      // メニューを開く
      menuButton?.addEventListener('click', () => {
        mobileMenu?.classList.remove('hidden');
        mobileMenuOverlay?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      });
      
      // 閉じるボタンクリック時
      closeButton?.addEventListener('click', closeMenu);
      
      // オーバーレイクリック時
      mobileMenuOverlay?.addEventListener('click', closeMenu);
      
      // セクションリンククリック時にメニューを閉じる
      const mobileLinks = document.querySelectorAll('#mobile-menu a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    });
  </script>
)}
