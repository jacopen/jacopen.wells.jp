---
import '../styles/global.css';
import { profileInfo } from '../data/profile-content';
import GTM from '../components/GTM.astro';

interface Props {
  title?: string;
  useTwoPane?: boolean;
  isProfilePage?: boolean;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
}

const {
  title = profileInfo.nameEn,
  useTwoPane = false,
  isProfilePage = false,
  ogDescription = profileInfo.bio,
  ogType = "website",
  ogImage = "/gentoo1.png"
} = Astro.props;
const { nameEn, nameJa, nickname } = profileInfo;

// セクションのリンク一覧（2ペーンレイアウト用）
const sections = [
  { id: "profile", title: "プロフィール", href: "/#profile", icon: "fa-user" },
  { id: "blog", title: "ブログ", href: "/#blog", icon: "fa-pen-to-square" },
  { id: "career", title: "経歴", href: "/#career", icon: "fa-briefcase" },
  { id: "presentations", title: "登壇", href: "/#presentations", icon: "fa-microphone" },
  { id: "skills", title: "スキル", href: "/#skills", icon: "fa-code" },
  { id: "certifications", title: "認定資格", href: "/#certifications", icon: "fa-award" },
  { id: "contributions", title: "寄稿 / メディア", href: "/#contributions", icon: "fa-newspaper" },
  { id: "books", title: "書籍", href: "/#books", icon: "fa-book" },
  { id: "communities", title: "コミュニティ", href: "/#communities", icon: "fa-users" },
  { id: "contact", title: "お問い合わせ", href: "/#contact", icon: "fa-envelope" }
];
---
<!doctype html>
<html lang="ja">
	<head>
		<GTM />

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

		<!-- OGP設定 -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />
		<meta property="og:site_name" content={profileInfo.nameEn} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@jacopen" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={new URL(ogImage, Astro.url)} />

		<!-- RSS/Atom フィード -->
		<link rel="alternate" type="application/rss+xml" title={`${profileInfo.nameEn} - ブログ (RSS)`} href="/feed.xml" />
		<link rel="alternate" type="application/atom+xml" title={`${profileInfo.nameEn} - ブログ (Atom)`} href="/atom.xml" />

		<!-- SEO関連 -->
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<meta name="robots" content="index, follow" />
	</head>
	<body class="min-h-screen">
    <div class="mx-auto max-w-6xl">
      {useTwoPane ? (
        <div class="container mx-auto px-4 py-6 max-w-full overflow-x-hidden">
          <!-- モバイル向けのヘッダー -->
          <div class="md:hidden mb-6">
            <div class="flex items-center justify-between">
              <button
                id="mobile-menu-button"
                class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-stone-200 text-stone-700 hover:border-green-300 hover:text-green-700 transition-all duration-200 shadow-sm"
                aria-label="メニューを開く"
              >
                <i class="fas fa-bars text-lg"></i>
                <span class="font-medium">メニュー</span>
              </button>

              {!isProfilePage && (
                <a href="/" class="flex items-center gap-3">
                  <img src="/gentoo1.png" alt={nameJa} class="w-10 h-10 rounded-full ring-2 ring-green-100" />
                  <span class="font-semibold text-stone-800">{nickname}</span>
                </a>
              )}
            </div>

            <!-- オーバーレイ背景 -->
            <div id="mobile-menu-overlay" class="fixed inset-0 bg-stone-900/60 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>

            <!-- モバイルメニュー -->
            <div id="mobile-menu" class="fixed inset-y-0 left-0 w-72 bg-white shadow-2xl z-50 overflow-y-auto hidden transform -translate-x-full transition-transform duration-300">
              <div class="p-5">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="text-lg font-bold text-stone-800" style="font-family: var(--font-display);">ナビゲーション</h3>
                  <button id="mobile-menu-close" class="p-2 rounded-lg text-stone-500 hover:text-stone-700 hover:bg-stone-100 transition-colors">
                    <i class="fas fa-times text-lg"></i>
                  </button>
                </div>

                {!isProfilePage && (
                  <div class="mb-6 p-4 bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border border-green-100">
                    <div class="flex items-center gap-4">
                      <a href="/">
                        <img src="/gentoo1.png" alt={nameJa} class="rounded-full w-16 h-16 ring-4 ring-white shadow-md" />
                      </a>
                      <div>
                        <h2 class="text-base font-bold text-stone-800" style="font-family: var(--font-display);">{nickname}</h2>
                        <p class="text-sm text-stone-600">{nameJa}</p>
                        <p class="text-xs text-stone-500">{nameEn}</p>
                      </div>
                    </div>
                    <div class="flex gap-3 mt-4 pt-4 border-t border-green-200/50">
                      <a href="https://x.com/jacopen" class="p-2 rounded-lg bg-white text-stone-600 hover:text-green-600 hover:shadow-md transition-all duration-200" aria-label="X (Twitter)"><i class="fab fa-x-twitter text-lg"></i></a>
                      <a href="https://www.facebook.com/jacopen" class="p-2 rounded-lg bg-white text-stone-600 hover:text-blue-600 hover:shadow-md transition-all duration-200" aria-label="Facebook"><i class="fab fa-facebook text-lg"></i></a>
                      <a href="https://github.com/jacopen" class="p-2 rounded-lg bg-white text-stone-600 hover:text-stone-900 hover:shadow-md transition-all duration-200" aria-label="GitHub"><i class="fab fa-github text-lg"></i></a>
                      <a href="https://www.linkedin.com/in/jacopen/" class="p-2 rounded-lg bg-white text-stone-600 hover:text-blue-700 hover:shadow-md transition-all duration-200" aria-label="LinkedIn"><i class="fab fa-linkedin text-lg"></i></a>
                    </div>
                  </div>
                )}

                <nav class="space-y-1">
                  {sections.map(section => (
                    <a
                      href={section.href}
                      class="flex items-center gap-3 py-3 px-4 text-stone-700 hover:text-green-700 hover:bg-green-50 rounded-xl transition-all duration-200 group"
                    >
                      <i class={`fas ${section.icon} w-5 text-center text-stone-400 group-hover:text-green-500 transition-colors`}></i>
                      <span class="font-medium">{section.title}</span>
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </div>

          <!-- 2ペインレイアウト -->
          <div class="flex flex-col md:flex-row gap-8 lg:gap-12">
            <!-- 左側サイドバー -->
            <aside class="hidden md:block md:w-56 lg:w-64 flex-shrink-0">
              <div class="sticky top-8">
                {!isProfilePage && (
                  <div class="mb-8 animate-fade-in-up">
                    <a href="/" class="block">
                      <div class="relative group">
                        <div class="absolute -inset-1 bg-gradient-to-br from-green-400 to-emerald-500 rounded-full opacity-20 group-hover:opacity-30 blur transition-opacity duration-300"></div>
                        <img
                          src="/gentoo1.png"
                          alt={nameJa}
                          class="relative rounded-full w-28 h-28 lg:w-32 lg:h-32 ml-auto ring-4 ring-white shadow-lg"
                        />
                      </div>
                    </a>
                    <div class="text-right mt-5">
                      <h2 class="text-xl font-bold text-stone-800" style="font-family: var(--font-display);">{nickname}</h2>
                      <p class="text-sm text-stone-600 mt-1">{nameJa}</p>
                      <p class="text-sm text-stone-500">{nameEn}</p>
                      <div class="flex gap-2 mt-4 justify-end">
                        <a href="https://x.com/jacopen" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-all duration-200" aria-label="X (Twitter)">
                          <i class="fab fa-x-twitter"></i>
                        </a>
                        <a href="https://www.facebook.com/jacopen" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200" aria-label="Facebook">
                          <i class="fab fa-facebook"></i>
                        </a>
                        <a href="https://github.com/jacopen" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-all duration-200" aria-label="GitHub">
                          <i class="fab fa-github"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/jacopen/" class="p-2.5 rounded-xl bg-stone-50 text-stone-500 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" aria-label="LinkedIn">
                          <i class="fab fa-linkedin"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                )}

                <nav class="space-y-1 animate-fade-in-up delay-200">
                  {sections.map((section, index) => (
                    <a
                      href={section.href}
                      class="nav-link group flex items-center justify-end gap-3 py-2.5 px-4 text-stone-600 hover:text-green-700 rounded-xl transition-all duration-200 text-right"
                      data-section={section.id}
                    >
                      <span class="font-medium text-sm">{section.title}</span>
                      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-stone-50 text-stone-400 group-hover:bg-green-50 group-hover:text-green-600 transition-all duration-200">
                        <i class={`fas ${section.icon} text-sm`}></i>
                      </span>
                    </a>
                  ))}
                </nav>

                <!-- Decorative element -->
                <div class="mt-8 h-px bg-gradient-to-r from-transparent via-stone-200 to-transparent"></div>
                <p class="mt-4 text-xs text-stone-400 text-right">&copy; 2024 {nameEn}</p>
              </div>
            </aside>

            <!-- メインコンテンツ -->
            <main class="flex-1 min-w-0 animate-fade-in-up delay-100">
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <slot />
      )}
    </div>
</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

  /* Active nav link style */
  .nav-link.active {
    color: #15803d;
    background: linear-gradient(90deg, transparent, rgba(22, 163, 74, 0.08));
  }

  .nav-link.active span:last-child {
    background: rgba(22, 163, 74, 0.1);
    color: #15803d;
  }
</style>

{useTwoPane && (
  <script>
    // ハンバーガーメニューの開閉を制御
    document.addEventListener('DOMContentLoaded', () => {
      const menuButton = document.getElementById('mobile-menu-button');
      const closeButton = document.getElementById('mobile-menu-close');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

      // メニューを閉じる関数
      const closeMenu = () => {
        mobileMenu?.classList.add('-translate-x-full');
        mobileMenuOverlay?.classList.add('opacity-0');
        setTimeout(() => {
          mobileMenu?.classList.add('hidden');
          mobileMenuOverlay?.classList.add('hidden');
        }, 300);
        document.body.classList.remove('overflow-hidden');
      };

      // メニューを開く関数
      const openMenu = () => {
        mobileMenu?.classList.remove('hidden');
        mobileMenuOverlay?.classList.remove('hidden');
        // Force reflow
        mobileMenu?.offsetHeight;
        mobileMenuOverlay?.offsetHeight;
        mobileMenu?.classList.remove('-translate-x-full');
        mobileMenuOverlay?.classList.remove('opacity-0');
        document.body.classList.add('overflow-hidden');
      };

      // メニューを開く
      menuButton?.addEventListener('click', openMenu);

      // 閉じるボタンクリック時
      closeButton?.addEventListener('click', closeMenu);

      // オーバーレイクリック時
      mobileMenuOverlay?.addEventListener('click', closeMenu);

      // セクションリンククリック時にメニューを閉じる
      const mobileLinks = document.querySelectorAll('#mobile-menu a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      // Intersection Observer for active nav highlighting
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = document.querySelectorAll('h2[id], div[id="profile"]');

      const observerOptions = {
        rootMargin: '-20% 0px -70% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach(link => {
              link.classList.remove('active');
              if (link.getAttribute('data-section') === id) {
                link.classList.add('active');
              }
            });
          }
        });
      }, observerOptions);

      sections.forEach(section => observer.observe(section));
    });
  </script>
)}
