---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  pubDate: Date;
  author: string;
  tags?: string[];
}

const { title, pubDate, author, tags = [] } = Astro.props;

// 日付のフォーマット
const formattedDate = `${pubDate.getFullYear()}年${pubDate.getMonth() + 1}月${pubDate.getDate()}日`;
---

<!-- ブログ記事用のOGP設定を含めてレイアウトに渡す -->
<Layout
  title={title}
  useTwoPane={true}
  isProfilePage={false}
  ogDescription={`${title} - ${author}による記事 ${tags.length > 0 ? `タグ: ${tags.join(', ')}` : ''}`}
  ogType="article"
>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-stone-500 mb-6">
    <a href="/" class="hover:text-green-600 transition-colors duration-200">
      <i class="fas fa-home"></i>
    </a>
    <i class="fas fa-chevron-right text-xs text-stone-300"></i>
    <a href="/blog/page/1" class="hover:text-green-600 transition-colors duration-200">ブログ</a>
    <i class="fas fa-chevron-right text-xs text-stone-300"></i>
    <span class="text-stone-700 font-medium truncate max-w-[200px] sm:max-w-none">{title}</span>
  </nav>

  <article class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <!-- Article Header -->
    <div class="relative px-6 sm:px-8 pt-8 pb-6 bg-gradient-to-br from-green-50/50 to-emerald-50/30 border-b border-stone-100">
      <!-- Decorative element -->
      <div class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-green-500 to-emerald-400"></div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-stone-800 leading-tight tracking-tight" style="font-family: var(--font-display);">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 mt-4 text-sm text-stone-500">
        <div class="flex items-center gap-2">
          <i class="far fa-calendar text-green-600"></i>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <div class="flex items-center gap-2">
          <i class="far fa-user text-green-600"></i>
          <span>{author}</span>
        </div>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map(tag => (
            <span class="inline-flex items-center px-3 py-1.5 text-xs font-semibold bg-white text-green-700 rounded-full border border-green-200 shadow-sm">
              <i class="fas fa-tag text-green-400 mr-1.5 text-[10px]"></i>
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Article Content -->
    <div class="px-6 sm:px-8 py-8">
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>
    </div>

    <!-- Article Footer -->
    <div class="px-6 sm:px-8 py-6 bg-stone-50/50 border-t border-stone-100">
      <a
        href="/blog/page/1"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-green-700 hover:text-green-800 bg-white hover:bg-green-50 rounded-xl border border-green-200 hover:border-green-300 transition-all duration-200 group"
      >
        <i class="fas fa-arrow-left text-xs transform group-hover:-translate-x-0.5 transition-transform duration-200"></i>
        ブログ一覧に戻る
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  /* Prose Typography - Editorial Style */
  .prose {
    color: #44403c;
    line-height: 1.8;
  }

  .prose h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: #1c1917;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .prose h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: #1c1917;
    margin-top: 2rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e7e5e4;
    letter-spacing: -0.01em;
  }

  .prose h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: #292524;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose h4 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: #292524;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .prose li::marker {
    color: #16a34a;
  }

  .prose a {
    color: #15803d;
    text-decoration: underline;
    text-decoration-color: #bbf7d0;
    text-underline-offset: 3px;
    transition: all 0.2s ease;
  }

  .prose a:hover {
    color: #166534;
    text-decoration-color: #15803d;
  }

  .prose strong {
    font-weight: 600;
    color: #1c1917;
  }

  .prose blockquote {
    border-left: 4px solid #22c55e;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    color: #166534;
  }

  .prose blockquote p {
    margin: 0;
  }

  .prose pre {
    background: linear-gradient(135deg, #1c1917 0%, #292524 100%);
    color: #f5f5f4;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .prose code {
    font-family: var(--font-mono);
    background-color: #f0fdf4;
    color: #166534;
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
    border: 1px solid #dcfce7;
  }

  .prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose img {
    max-width: 100%;
    border-radius: 0.75rem;
    margin: 1.5rem 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .prose hr {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, #d6d3d1, transparent);
    margin: 2rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .prose th {
    background-color: #f5f5f4;
    font-weight: 600;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #e7e5e4;
  }

  .prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e7e5e4;
  }

  .prose tr:hover td {
    background-color: #fafaf9;
  }
</style>
