---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  pubDate: Date;
  author: string;
  tags?: string[];
}

const { title, pubDate, author, tags = [] } = Astro.props;

// 日付のフォーマット
const formattedDate = `${pubDate.getFullYear()}年${pubDate.getMonth() + 1}月${pubDate.getDate()}日`;
---

<!-- ブログ記事用のOGP設定を含めてレイアウトに渡す -->
<Layout 
  title={title} 
  useTwoPane={true} 
  isProfilePage={false}
  ogDescription={`${title} - ${author}による記事 ${tags.length > 0 ? `タグ: ${tags.join(', ')}` : ''}`}
  ogType="article"
>
    <!-- パンくずリスト -->
    <div class="text-sm mb-6 text-gray-600">
      <a href="/" class="hover:text-blue-600">ホーム</a> &gt; 
      <a href="/#blog" class="hover:text-blue-600">ブログ</a> &gt; 
      <span class="text-gray-800">{title}</span>
    </div>

    <article class="bg-white p-6 rounded-lg shadow-sm">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
      
      <div class="flex items-center text-gray-600 mb-6">
        <span class="mr-4">{formattedDate}</span>
        <span class="mr-4">著者: {author}</span>
        {tags.length > 0 && (
          <div class="flex flex-wrap">
            {tags.map(tag => (
              <span class="bg-gray-100 text-gray-700 px-2 py-1 text-xs rounded mr-2 mb-1">{tag}</span>
            ))}
          </div>
        )}
      </div>

      <div class="prose max-w-none">
        <slot />
      </div>

      <div class="mt-10 pt-6 border-t border-gray-200">
        <a href="/#blog" class="text-blue-600 hover:text-blue-800">
          &larr; ブログ一覧に戻る
        </a>
      </div>
    </article>
</Layout>

<style is:global>
  .prose h1 { font-size: 1.5rem; font-weight: bold; margin-top: 2rem; margin-bottom: 1rem; }
  .prose h2 { font-size: 1.25rem; font-weight: bold; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose h3 { font-size: 1.125rem; font-weight: bold; margin-top: 1.25rem; margin-bottom: 0.5rem; }
  .prose p { margin-top: 1rem; margin-bottom: 1rem; }
  .prose ul { list-style-type: disc; padding-left: 1.25rem; margin-top: 1rem; margin-bottom: 1rem; }
  .prose ol { list-style-type: decimal; padding-left: 1.25rem; margin-top: 1rem; margin-bottom: 1rem; }
  .prose a { color: #2563eb; }
  .prose a:hover { color: #1e40af; }
  .prose blockquote { border-left: 4px solid #d1d5db; padding-left: 1rem; font-style: italic; margin-top: 1rem; margin-bottom: 1rem; }
  .prose pre { background-color: #f3f4f6; padding: 1rem; border-radius: 0.25rem; overflow-x: auto; margin-top: 1rem; margin-bottom: 1rem; }
  .prose code { background-color: #f3f4f6; padding: 0.125rem 0.25rem; border-radius: 0.25rem; font-size: 0.875rem; }
  .prose img { max-width: 100%; border-radius: 0.25rem; margin-top: 1rem; margin-bottom: 1rem; }
</style>
